From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: "ffmpeg.wasm" <ffmpeg.wasm@users.noreply.github.com>
Date: Mon, 28 Sep 2026 22:13:50 -0400
Subject: [PATCH 5/5] fftools: reset global state between commands

---
 fftools/cmdutils.c   |  8 ++++++++
 fftools/cmdutils.h   |  7 +++++++
 fftools/ffmpeg.c     | 47 ++++++++++++++++++++++++++++++++++++--------
 fftools/ffmpeg.h     |  1 +
 fftools/ffmpeg_opt.c | 28 ++++++++++++++++++++++++++
 fftools/ffprobe.c    | 40 +++++++++++++++++++++++++++++++++++++
 6 files changed, 123 insertions(+), 8 deletions(-)

diff --git a/fftools/cmdutils.c b/fftools/cmdutils.c
index 9fdd680..d6178a1 100644
--- a/fftools/cmdutils.c
+++ b/fftools/cmdutils.c
@@ -59,6 +59,14 @@ AVDictionary *format_opts, *codec_opts;
 
 int hide_banner = 0;
 
+void reset_log(void)
+{
+    av_log_set_callback(av_log_default_callback);
+    av_log_set_level(AV_LOG_INFO);
+    av_log_set_flags(0);
+    hide_banner = 0;
+}
+
 void uninit_opts(void)
 {
     av_dict_free(&swr_opts);
diff --git a/fftools/cmdutils.h b/fftools/cmdutils.h
index 3fc3a5a..8f10a10 100644
--- a/fftools/cmdutils.h
+++ b/fftools/cmdutils.h
@@ -49,6 +49,13 @@ extern AVDictionary *swr_opts;
 extern AVDictionary *format_opts, *codec_opts;
 extern int hide_banner;
 
+/**
+ * Restore libavutil's default log callback, level and flags. Options like -h,
+ * -loglevel or -report change them for the rest of the process, and
+ * ffmpeg.wasm runs many commands in one process.
+ */
+void reset_log(void);
+
 /* ffmpeg.wasm links ffmpeg and ffprobe into one module, so their main() and
  * show_help_default() are renamed. */
 int ffmpeg(int argc, char **argv);
diff --git a/fftools/ffmpeg.c b/fftools/ffmpeg.c
index d053c5d..068ae2a 100644
--- a/fftools/ffmpeg.c
+++ b/fftools/ffmpeg.c
@@ -590,6 +590,9 @@ static void report_progress(int is_last_report, int64_t pts)
         send_progress(duration > 0 ? FFMIN((double)FFABS(pts) / duration, 1) : 0, FFABS(pts));
 }
 
+static int64_t report_last_time = -1;
+static int report_first = 1;
+
 static void print_report(int is_last_report, int64_t timer_start, int64_t cur_time, int64_t pts)
 {
     AVBPrint buf, buf_script;
@@ -597,8 +600,6 @@ static void print_report(int is_last_report, int64_t timer_start, int64_t cur_ti
     int vid;
     double bitrate;
     double speed;
-    static int64_t last_time = -1;
-    static int first_report = 1;
     uint64_t nb_frames_dup = 0, nb_frames_drop = 0;
     int mins, secs, ms, us;
     int64_t hours;
@@ -612,13 +613,13 @@ static void print_report(int is_last_report, int64_t timer_start, int64_t cur_ti
         return;
 
     if (!is_last_report) {
-        if (last_time == -1) {
-            last_time = cur_time;
+        if (report_last_time == -1) {
+            report_last_time = cur_time;
         }
-        if (((cur_time - last_time) < stats_period && !first_report) ||
-            (first_report && atomic_load(&nb_output_dumped) < nb_output_files))
+        if (((cur_time - report_last_time) < stats_period && !report_first) ||
+            (report_first && atomic_load(&nb_output_dumped) < nb_output_files))
             return;
-        last_time = cur_time;
+        report_last_time = cur_time;
     }
 
     t = (cur_time-timer_start) / 1000000.0;
@@ -751,7 +752,7 @@ static void print_report(int is_last_report, int64_t timer_start, int64_t cur_ti
         }
     }
 
-    first_report = 0;
+    report_first = 0;
 }
 
 static void print_stream_maps(void)
@@ -1013,6 +1014,35 @@ static int64_t getmaxrss(void)
 #endif
 }
 
+/* ffmpeg.wasm runs ffmpeg() many times in one process: put every global back
+ * to its initial value first. */
+static void init_globals(void)
+{
+    program_name = "ffmpeg";
+    program_birth_year = 2000;
+    vstats_file = NULL;
+    atomic_store(&nb_output_dumped, 0);
+    progress_avio = NULL;
+    input_files = NULL;
+    nb_input_files = 0;
+    output_files = NULL;
+    nb_output_files = 0;
+    filtergraphs = NULL;
+    nb_filtergraphs = 0;
+    decoders = NULL;
+    nb_decoders = 0;
+    received_sigterm = 0;
+    received_nb_signals = 0;
+    atomic_store(&transcode_init_done, 0);
+    ffmpeg_exited = 0;
+    copy_ts_first_pts = AV_NOPTS_VALUE;
+    report_last_time = -1;
+    report_first = 1;
+    timed_out = 0;
+    reset_options();
+    reset_log();
+}
+
 /* main() renamed, as ffmpeg.wasm links ffmpeg and ffprobe into one module. */
 int ffmpeg(int argc, char **argv)
 {
@@ -1021,6 +1051,7 @@ int ffmpeg(int argc, char **argv)
     int ret;
     BenchmarkTimeStamps ti;
 
+    init_globals();
     init_dynload();
 
     setvbuf(stderr,NULL,_IONBF,0); /* win32 runtime needs this */
diff --git a/fftools/ffmpeg.h b/fftools/ffmpeg.h
index c44aaf6..e5c75cb 100644
--- a/fftools/ffmpeg.h
+++ b/fftools/ffmpeg.h
@@ -823,6 +823,7 @@ void fg_send_command(FilterGraph *fg, double time, const char *target,
                      const char *command, const char *arg, int all_filters);
 
 int ffmpeg_parse_options(int argc, char **argv, Scheduler *sch);
+void reset_options(void);
 
 void enc_stats_write(OutputStream *ost, EncStats *es,
                      const AVFrame *frame, const AVPacket *pkt,
diff --git a/fftools/ffmpeg_opt.c b/fftools/ffmpeg_opt.c
index 14eb5e8..cbcd1f0 100644
--- a/fftools/ffmpeg_opt.c
+++ b/fftools/ffmpeg_opt.c
@@ -87,6 +87,34 @@ int ignore_unknown_streams = 0;
 int copy_unknown_streams = 0;
 int recast_media = 0;
 
+/* ffmpeg.wasm runs ffmpeg() many times in one process: put every option
+ * global back to its default so one command's options don't leak into the
+ * next (e.g. -n would make every later command fail). */
+void reset_options(void)
+{
+    filter_hw_device = NULL;
+    vstats_filename = NULL;
+    dts_delta_threshold = 10;
+    dts_error_threshold = 3600*30;
+    frame_drop_threshold = 0;
+    do_benchmark = do_benchmark_all = do_hex_dump = do_pkt_dump = 0;
+    copy_ts = start_at_zero = 0;
+    copy_tb = -1;
+    debug_ts = exit_on_error = abort_on_flags = 0;
+    print_stats = -1;
+    stdin_interaction = 1;
+    max_error_rate = 2.0/3;
+    filter_nbthreads = NULL;
+    filter_complex_nbthreads = filter_buffered_frames = 0;
+    vstats_version = 2;
+    print_graphs = 0;
+    print_graphs_file = print_graphs_format = NULL;
+    auto_conversion_filters = 1;
+    stats_period = 500000;
+    file_overwrite = no_file_overwrite = 0;
+    ignore_unknown_streams = copy_unknown_streams = recast_media = 0;
+}
+
 // this struct is passed as the optctx argument
 // to func_arg() for global options
 typedef struct GlobalOptionsContext {
diff --git a/fftools/ffprobe.c b/fftools/ffprobe.c
index ece8b36..9e9176c 100644
--- a/fftools/ffprobe.c
+++ b/fftools/ffprobe.c
@@ -3361,6 +3361,44 @@ static inline int check_section_show_entries(int section_id)
             do_show_##varname = 1;                                      \
     } while (0)
 
+/* ffmpeg.wasm runs ffprobe() many times in one process: put every global back
+ * to its initial value first. */
+static void reset_globals(void)
+{
+    do_analyze_frames = do_bitexact = do_count_frames = do_count_packets = 0;
+    do_read_frames = do_read_packets = 0;
+    do_show_chapters = do_show_error = do_show_format = do_show_frames = 0;
+    do_show_packets = do_show_programs = do_show_stream_groups = 0;
+    do_show_stream_group_components = do_show_streams = 0;
+    do_show_stream_disposition = do_show_stream_group_disposition = 0;
+    do_show_data = do_show_program_version = do_show_library_versions = 0;
+    do_show_pixel_formats = do_show_pixel_format_flags = do_show_pixel_format_components = 0;
+    do_show_log = 0;
+    do_show_chapter_tags = do_show_format_tags = do_show_frame_tags = 0;
+    do_show_program_tags = do_show_stream_group_tags = do_show_stream_tags = 0;
+    do_show_packet_tags = 0;
+    show_value_unit = use_value_prefix = use_byte_value_binary_prefix = 0;
+    use_value_sexagesimal_format = 0;
+    show_private_data = 1;
+    audio_codec_name = data_codec_name = subtitle_codec_name = video_codec_name = NULL;
+    show_optional_fields = SHOW_OPTIONAL_FIELDS_AUTO;
+    output_format = stream_specifier = show_data_hash = data_dump_format = NULL;
+    read_intervals = NULL;
+    read_intervals_nb = 0;
+    find_stream_info = 1;
+    for (int i = 0; i < FF_ARRAY_ELEMS(selected_entries); i++) {
+        selected_entries[i].show_all_entries = 0;
+        av_dict_free(&selected_entries[i].entries_to_show);
+    }
+    input_filename = print_input_filename = output_filename = NULL;
+    iformat = NULL;
+    nb_streams = 0;
+    nb_streams_packets = nb_streams_frames = NULL;
+    selected_streams = streams_with_closed_captions = streams_with_film_grain = NULL;
+    log_buffer = NULL;
+    log_buffer_size = 0;
+}
+
 int ffprobe(int argc, char **argv)
 {
     const AVTextFormatter *f;
@@ -3375,6 +3413,8 @@ int ffprobe(int argc, char **argv)
 
     setvbuf(stderr, NULL, _IONBF, 0); /* win32 runtime needs this */
 
+    reset_globals();
+    reset_log();
     program_name = "ffprobe";
     program_birth_year = 2007;
     av_log_set_flags(AV_LOG_SKIP_REPEATED);
