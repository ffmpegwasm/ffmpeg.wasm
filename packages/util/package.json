{
  "name": "@ffmpeg/util",
  "version": "0.13.0",
  "description": "utils for @ffmpeg/*",
  "main": "./dist/cjs/index.js",
  "type": "module",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "node": {
        "import": "./dist/esm/node.js",
        "require": "./dist/cjs/node.js"
      },
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "scripts": {
    "dev": "tsc -p tsconfig-esm.json --watch",
    "lint": "eslint src",
    "clean": "rimraf dist",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:umd": "tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', '{\\\"type\\\": \\\"commonjs\\\"}')\" && webpack",
    "build": "pnpm clean && pnpm build:esm && pnpm build:umd",
    "prepublishOnly": "pnpm build"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ffmpegwasm/ffmpeg.wasm.git"
  },
  "keywords": [
    "ffmpeg",
    "video",
    "audio",
    "transcode"
  ],
  "author": "Jerome Wu <jeromewus@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ffmpegwasm/ffmpeg.wasm/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "homepage": "https://github.com/ffmpegwasm/ffmpeg.wasm#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3"
  }
}
