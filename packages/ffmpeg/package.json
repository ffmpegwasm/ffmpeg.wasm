{
  "name": "@ffmpeg/ffmpeg",
  "version": "0.12.15",
  "description": "FFmpeg WebAssembly version for browsers and Node.js",
  "main": "./dist/umd/ffmpeg.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "node": "./dist/esm/node/index.js",
      "default": {
        "import": "./dist/esm/index.js",
        "require": "./dist/umd/ffmpeg.js"
      }
    },
    "./worker": {
      "types": "./dist/esm/worker.d.ts",
      "default": "./dist/esm/worker.js"
    }
  },
  "scripts": {
    "dev": "webpack -w --mode development",
    "lint": "eslint src",
    "clean": "rimraf dist",
    "build:esm": "tsc -p tsconfig.esm.json && node -e \"require('fs').writeFileSync('dist/esm/package.json', '{\\\"type\\\": \\\"module\\\"}')\"",
    "build:umd": "webpack",
    "build": "pnpm clean && pnpm build:esm && pnpm build:umd",
    "prepublishOnly": "pnpm build"
  },
  "files": [
    "dist",
    "types/ffmpeg.d.ts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ffmpegwasm/ffmpeg.wasm.git"
  },
  "keywords": [
    "ffmpeg",
    "WebAssembly",
    "video",
    "audio",
    "transcode"
  ],
  "author": "Jerome Wu <jeromewus@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ffmpegwasm/ffmpeg.wasm/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "homepage": "https://github.com/ffmpegwasm/ffmpeg.wasm#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@ffmpeg/core": "workspace:*",
    "@types/node": "^22.20.4",
    "@typescript-eslint/eslint-plugin": "^6.1.0",
    "@typescript-eslint/parser": "^6.1.0",
    "eslint": "^8.45.0",
    "rimraf": "^5.0.1",
    "typescript": "^5.1.6",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@ffmpeg/types": "workspace:*"
  },
  "peerDependencies": {
    "@ffmpeg/core": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@ffmpeg/core": {
      "optional": true
    }
  }
}
